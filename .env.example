APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Spring Backend -> FastAPI service authentication
SERVICE_TOKEN=change-me

# AI-owned transient state and product catalog
REDIS_URL=redis://127.0.0.1:6379/0
AI_DATABASE_URL=postgresql+asyncpg://ai_app:change-me@postgres:5432/ai_catalog

# ---- LLM provider: 사용할 블록 하나만 주석 해제 ----

# [OpenRouter] V1 운영 · 실제 모델 호출
RESPONSE_MODEL_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL_BASE_URL=https://openrouter.ai/api/v1
RESPONSE_MODEL_NAME=google/gemini-2.5-flash
EXTRACTION_MODEL_NAME=google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=

# [LM Studio] 로컬 테스트 · 위 OpenRouter 블록을 주석 처리하고 아래를 해제
# 모델명은 LM Studio에 로드한 모델 식별자와 같아야 하고, 키는 필요 없다
# RESPONSE_MODEL_BASE_URL=http://localhost:1234/v1
# EXTRACTION_MODEL_BASE_URL=http://localhost:1234/v1
# RESPONSE_MODEL_NAME=local-response-model
# EXTRACTION_MODEL_NAME=local-extraction-model

# [V2 자체 GPU] 엔드포인트와 모델명만 바뀐다
# RESPONSE_MODEL_BASE_URL=https://gpu.example.com/response/v1
# EXTRACTION_MODEL_BASE_URL=https://gpu.example.com/extract/v1
# RESPONSE_MODEL_NAME=kanana-response
# EXTRACTION_MODEL_NAME=kanana-extractor

RESPONSE_MODEL_TIMEOUT_SECONDS=60
EXTRACTION_MODEL_TIMEOUT_SECONDS=30
SUMMARY_MODEL_TIMEOUT_SECONDS=5
# 출력 토큰 상한. 비우면 OpenRouter가 모델 최대치를 예약해 크레딧 부족(402)이 난다
RESPONSE_MODEL_MAX_TOKENS=2048
EXTRACTION_MODEL_MAX_TOKENS=2048
