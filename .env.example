APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Spring Backend -> FastAPI service authentication
SERVICE_TOKEN=change-me

# AI-owned transient state and product catalog
REDIS_URL=redis://redis:6379/0
AI_DATABASE_URL=postgresql+asyncpg://ai_app:change-me@postgres:5432/ai_catalog

# V1: external OpenAI-compatible model API
RESPONSE_MODEL_BASE_URL=https://provider.example.com/v1
EXTRACTION_MODEL_BASE_URL=https://provider.example.com/v1
MODEL_API_KEY=change-me
RESPONSE_MODEL_NAME=response-model
EXTRACTION_MODEL_NAME=extraction-model

# V2 changes only the endpoint/model values above, for example:
# RESPONSE_MODEL_BASE_URL=https://gpu.example.com/response/v1
# EXTRACTION_MODEL_BASE_URL=https://gpu.example.com/extract/v1
# RESPONSE_MODEL_NAME=kanana-response
# EXTRACTION_MODEL_NAME=kanana-extractor
