APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Spring Backend -> FastAPI service authentication
SERVICE_TOKEN=change-me

# AI-owned transient state
REDIS_URL=redis://127.0.0.1:6379/0

# Backend MySQL product source (read-only)
SOURCE_MYSQL_HOST=127.0.0.1
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_USER=ai_reader
SOURCE_MYSQL_PASSWORD=
SOURCE_MYSQL_DATABASE=needu
SOURCE_MYSQL_TABLE=products

# AI catalog PostgreSQL: batch writer and API reader
CATALOG_DATABASE_URL=postgresql://ai_catalog_batch:change-me@127.0.0.1:5432/needu_vector?sslmode=disable
CATALOG_DATABASE_URL_RO=postgresql://ai_catalog_api:change-me@127.0.0.1:5432/needu_vector?sslmode=disable

# ---- LLM provider: 사용할 블록 하나만 주석 해제 ----

# [OpenRouter] V1 운영 · 실제 모델 호출
RESPONSE_MODEL_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL_BASE_URL=https://openrouter.ai/api/v1
RESPONSE_MODEL_NAME=google/gemini-3.5-flash-lite
EXTRACTION_MODEL_NAME=google/gemini-3.5-flash-lite
OPENROUTER_API_KEY=

# [LM Studio] 로컬 테스트 · 위 OpenRouter 블록을 주석 처리하고 아래를 해제
# 모델명은 LM Studio에 로드한 모델 식별자와 같아야 하고, 키는 필요 없다
# RESPONSE_MODEL_BASE_URL=http://localhost:1234/v1
# EXTRACTION_MODEL_BASE_URL=http://localhost:1234/v1
# RESPONSE_MODEL_NAME=local-response-model
# EXTRACTION_MODEL_NAME=local-extraction-model

# [LM Studio] catalog document generation
# DOCUMENT_MODEL_BASE_URL=http://127.0.0.1:1234/v1
# DOCUMENT_MODEL_NAME=kanana-1.5-8b-instruct-2505
# DOCUMENT_MODEL_MAX_TOKENS=1024
# DOCUMENT_MODEL_CONCURRENCY=1
# DOCUMENT_MODEL_ENABLE_THINKING=false
# DOCUMENT_MODEL_TEMPERATURE=0.2
# DOCUMENT_MODEL_STOP_SEQUENCE=<|eot_id|>
# DOCUMENT_MODEL_TIMEOUT_SECONDS=180
# CATALOG_ENRICH_BATCH_SIZE=100
# CATALOG_ENRICH_EMBEDDING_CONCURRENCY=4
# CATALOG_ENRICH_PROGRESS_INTERVAL=100

# [V2 자체 GPU] 엔드포인트와 모델명만 바뀐다
# RESPONSE_MODEL_BASE_URL=https://gpu.example.com/response/v1
# EXTRACTION_MODEL_BASE_URL=https://gpu.example.com/extract/v1
# RESPONSE_MODEL_NAME=kanana-response
# EXTRACTION_MODEL_NAME=kanana-extractor

RESPONSE_MODEL_TIMEOUT_SECONDS=60
EXTRACTION_MODEL_TIMEOUT_SECONDS=30
SUMMARY_MODEL_TIMEOUT_SECONDS=5
# 출력 토큰 상한. 비우면 OpenRouter가 모델 최대치를 예약해 크레딧 부족(402)이 난다
RESPONSE_MODEL_MAX_TOKENS=2048
EXTRACTION_MODEL_MAX_TOKENS=2048

# ---- Embedding: Upstage Solar Embedding 2 (1024차원) ----
# passage는 상품 문서(content/usage/gift), query는 사용자 취향 문장에 쓴다.
# 두 모델은 같은 벡터 공간을 쓰며 EMBEDDING_SPACE_ID가 DB의 embedding_model_version 값이다.
# 모델·차원을 바꾸면 기존 상품 벡터를 전부 다시 만들어야 한다.
EMBEDDING_BASE_URL=https://api.upstage.ai/v1
EMBEDDING_SPACE_ID=solar-embedding-2
EMBEDDING_PASSAGE_MODEL_NAME=solar-embedding-2-passage
EMBEDDING_QUERY_MODEL_NAME=solar-embedding-2-query
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_SECONDS=30
UPSTAGE_API_KEY=
