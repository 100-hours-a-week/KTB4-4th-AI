LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_API_KEY=lm-studio

# 응답 모델 — 대화만 한다. 첫 글자가 빨리 나와야 해서 이게 중요하다
NIJU_RESPONSE_MODEL=kanana-1.5-8b-instruct-2505
# 추출 모델 — 스키마만 채운다. 사용자가 안 기다리는 호출
NIJU_EXTRACT_MODEL=kanana-2-3b-instruct-i1

NIJU_RESPONSE_TEMP=0.7
NIJU_EXTRACT_TEMP=0.1

# reasoning 모델을 쓸 때만 1. thinking 을 끄면 지연이 절반으로 준다
NIJU_NO_THINK=0
